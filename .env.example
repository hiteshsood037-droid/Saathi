# Jodi App - Supabase Environment Configuration
#
# Copy this file to .env and fill in your Supabase project credentials.
# In Expo, all environment variables must be prefixed with EXPO_PUBLIC_
# to be accessible in client-side code.
#
# You can find these values in your Supabase project dashboard:
# Settings → API → Project URL & anon/public key

# Your Supabase project URL (e.g., https://abcdefghijklm.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key (non-secret, safe for client-side use)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============ How it works ============
# - When these variables are set: the app uses the real Supabase client
# - When they're NOT set: the app falls back to MockSupabaseClient
#   with in-memory mock data for development/testing
#
# The IS_MOCK flag in src/config.ts detects this automatically.
# No other changes needed — all screens work in both modes.