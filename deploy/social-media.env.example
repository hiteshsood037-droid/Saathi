# Jodi social media + music catalog production environment
# Copy values into your secret manager / Supabase Edge Function secrets.
# Never add this file with real values to git.

# Existing Supabase service configuration (server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated, exact browser origins. HTTPS only in production.
# Do NOT use `*`; add every deployed web origin explicitly.
APP_ALLOWED_ORIGINS=https://<your-public-web-origin>

# Private media URLs are minted only after visibility checks.
# Keep at or below 600 seconds; 300 is the production default.
MEDIA_SIGNED_URL_TTL_SECONDS=300

# Spotify application credentials, server-only.
# The client ID is also kept server-side because the music catalog Edge Function
# uses the Client Credentials flow; do not prefix either value with EXPO_PUBLIC_.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Optional only if a future user-authorized Spotify OAuth feature is enabled.
# This catalog-search integration does NOT need it or request any user scopes.
SPOTIFY_REDIRECT_URI=https://<your-public-web-origin>/music/callback

# Client app environment: only Supabase's public URL/key belong in the Expo .env.
# No Spotify credential, service-role key, or storage signing credential may be
# shipped in an EXPO_PUBLIC_ variable.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
